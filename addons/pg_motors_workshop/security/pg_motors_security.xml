<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_pg_motors_user" model="res.groups">
        <field name="name">Workshop User</field>
        <field name="category_id" ref="base.module_category_services_workshop"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pg_motors_manager" model="res.groups">
        <field name="name">Workshop Manager</field>
        <field name="category_id" ref="base.module_category_services_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_pg_motors_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="pg_motors_customer_rule" model="ir.rule">
        <field name="name">PG Motors Customer: Multi-Company</field>
        <field name="model_id" ref="model_pg_motors_customer"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="pg_motors_vehicle_rule" model="ir.rule">
        <field name="name">PG Motors Vehicle: Multi-Company</field>
        <field name="model_id" ref="model_pg_motors_vehicle"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="pg_motors_job_rule" model="ir.rule">
        <field name="name">PG Motors Job: Multi-Company</field>
        <field name="model_id" ref="model_pg_motors_workshop_job"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
