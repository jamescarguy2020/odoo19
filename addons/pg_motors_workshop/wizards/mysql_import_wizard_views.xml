<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- MySQL Import Wizard Form View -->
    <record id="view_mysql_import_wizard_form" model="ir.ui.view">
        <field name="name">mysql.import.wizard.form</field>
        <field name="model">mysql.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import MySQL Data">
                <group invisible="state == 'done'">
                    <group>
                        <field name="sql_file" filename="sql_filename"/>
                        <field name="sql_filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="import_customers"/>
                        <field name="import_vehicles"/>
                        <field name="auto_match_brands"/>
                    </group>
                </group>
                
                <group invisible="state != 'done'">
                    <group string="Import Results">
                        <field name="customers_created" readonly="1"/>
                        <field name="vehicles_created" readonly="1"/>
                        <field name="brands_matched" readonly="1"/>
                    </group>
                </group>
                
                <notebook invisible="state != 'done'">
                    <page string="Import Log" name="log">
                        <field name="import_log" readonly="1"/>
                    </page>
                </notebook>
                
                <footer>
                    <button string="Import" name="action_import" type="object" class="oe_highlight" invisible="state == 'done'"/>
                    <button string="Close" special="cancel"/>
                </footer>
                <field name="state" invisible="1"/>
            </form>
        </field>
    </record>

    <!-- MySQL Import Wizard Action -->
    <record id="action_mysql_import_wizard" model="ir.actions.act_window">
        <field name="name">Import MySQL Data</field>
        <field name="res_model">mysql.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p>
                Import customers and vehicles from your MySQL database export.
            </p>
            <p>
                Upload your SQL dump file and the system will automatically parse and import the data.
            </p>
        </field>
    </record>

</odoo>
