<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Workshop Job Tree View -->
    <record id="view_workshop_workshop_job_tree" model="ir.ui.view">
        <field name="name">workshop.workshop.job.tree</field>
        <field name="model">workshop.workshop.job</field>
        <field name="arch" type="xml">
            <tree string="Workshop Jobs" decoration-info="state=='draft'" decoration-success="state=='completed'" decoration-warning="state=='waiting_parts'">
                <field name="job_number"/>
                <field name="job_date"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="registration"/>
                <field name="name"/>
                <field name="mechanic_id"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-success="state=='completed'"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>

    <!-- Workshop Job Form View -->
    <record id="view_workshop_workshop_job_form" model="ir.ui.view">
        <field name="name">workshop.workshop.job.form</field>
        <field name="model">workshop.workshop.job</field>
        <field name="arch" type="xml">
            <form string="Workshop Job">
                <header>
                    <button name="action_start_job" string="Start Job" type="object" class="oe_highlight" invisible="state not in ['draft', 'scheduled']"/>
                    <button name="action_complete_job" string="Complete Job" type="object" class="oe_highlight" invisible="state not in ['in_progress', 'ready']"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="oe_highlight" invisible="state not in ['completed'] or invoice_id"/>
                    <button name="action_view_invoice" string="View Invoice" type="object" invisible="not invoice_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="job_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Job Information">
                            <field name="name"/>
                            <field name="job_date"/>
                            <field name="scheduled_date"/>
                            <field name="completion_date" invisible="not completion_date"/>
                            <field name="mechanic_id"/>
                        </group>
                        <group string="Customer & Vehicle">
                            <field name="customer_id"/>
                            <field name="vehicle_id" domain="[('customer_id', '=', customer_id)]"/>
                            <field name="registration" readonly="1"/>
                            <field name="odometer_reading"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Labour" name="labour">
                            <field name="labour_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="hours"/>
                                    <field name="rate"/>
                                    <field name="total"/>
                                    <field name="mechanic_id"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="labour_total" widget="monetary"/>
                            </group>
                        </page>
                        
                        <page string="Parts" name="parts">
                            <field name="parts_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="part_number"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="total"/>
                                    <field name="supplier_id"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="parts_total" widget="monetary"/>
                            </group>
                        </page>
                        
                        <page string="Totals" name="totals">
                            <group class="oe_subtotal_footer oe_right">
                                <field name="labour_total" widget="monetary"/>
                                <field name="parts_total" widget="monetary"/>
                                <field name="subtotal" widget="monetary"/>
                                <field name="tax_amount" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="total_amount"/>
                                </div>
                                <field name="total_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                        
                        <page string="Notes" name="notes">
                            <group>
                                <field name="service_notes" placeholder="Service notes for customer..."/>
                                <field name="internal_notes" placeholder="Internal notes..."/>
                            </group>
                        </page>
                        
                        <page string="Invoice" name="invoice" invisible="not invoice_id">
                            <group>
                                <field name="invoice_id"/>
                                <field name="invoice_status"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Workshop Job Search View -->
    <record id="view_workshop_workshop_job_search" model="ir.ui.view">
        <field name="name">workshop.workshop.job.search</field>
        <field name="model">workshop.workshop.job</field>
        <field name="arch" type="xml">
            <search string="Search Workshop Jobs">
                <field name="job_number"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="registration"/>
                <field name="mechanic_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Invoiced" name="invoiced" domain="[('state', '=', 'invoiced')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('job_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('job_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('job_date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Mechanic" name="group_mechanic" context="{'group_by': 'mechanic_id'}"/>
                    <filter string="Job Date" name="group_date" context="{'group_by': 'job_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Workshop Job Action -->
    <record id="action_workshop_workshop_job" model="ir.actions.act_window">
        <field name="name">Workshop Jobs</field>
        <field name="res_model">workshop.workshop.job</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first workshop job
            </p>
            <p>
                Create and manage workshop repair jobs with labour and parts tracking.
            </p>
        </field>
    </record>

</odoo>
