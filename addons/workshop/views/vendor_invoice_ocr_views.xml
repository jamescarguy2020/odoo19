<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendor Invoice OCR Tree View -->
    <record id="view_vendor_invoice_ocr_tree" model="ir.ui.view">
        <field name="name">vendor.invoice.ocr.tree</field>
        <field name="model">vendor.invoice.ocr</field>
        <field name="arch" type="xml">
            <tree string="Vendor Invoice OCR" decoration-info="state=='pending'" decoration-success="state=='processed'" decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="email_from"/>
                <field name="vendor_id"/>
                <field name="invoice_number"/>
                <field name="invoice_date"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Vendor Invoice OCR Form View -->
    <record id="view_vendor_invoice_ocr_form" model="ir.ui.view">
        <field name="name">vendor.invoice.ocr.form</field>
        <field name="model">vendor.invoice.ocr</field>
        <field name="arch" type="xml">
            <form string="Vendor Invoice OCR">
                <header>
                    <button name="action_extract_data" string="Extract Data" type="object" class="oe_highlight" invisible="state != 'pending' or extracted_text"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_create_bill" string="Create Bill" type="object" class="oe_highlight" invisible="state != 'approved' or bill_id"/>
                    <button name="action_view_bill" string="View Bill" type="object" invisible="not bill_id"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ['pending', 'approved']"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,processed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Email Information">
                            <field name="email_from"/>
                            <field name="email_subject"/>
                            <field name="email_date"/>
                            <field name="pdf_filename"/>
                        </group>
                        <group string="Invoice Details">
                            <field name="vendor_id"/>
                            <field name="vendor_name_extracted" readonly="1"/>
                            <field name="invoice_number"/>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    
                    <group string="Amounts">
                        <group>
                            <field name="subtotal"/>
                            <field name="tax_amount"/>
                            <field name="total_amount"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="PDF Invoice" name="pdf">
                            <field name="pdf_file" filename="pdf_filename" widget="pdf_viewer"/>
                        </page>
                        
                        <page string="Extracted Text" name="extracted_text" invisible="not extracted_text">
                            <field name="extracted_text"/>
                        </page>
                        
                        <page string="Line Items" name="line_items" invisible="not line_items_text">
                            <field name="line_items_text"/>
                        </page>
                        
                        <page string="Vendor Bill" name="bill" invisible="not bill_id">
                            <group>
                                <field name="bill_id"/>
                            </group>
                        </page>
                        
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vendor Invoice OCR Search View -->
    <record id="view_vendor_invoice_ocr_search" model="ir.ui.view">
        <field name="name">vendor.invoice.ocr.search</field>
        <field name="model">vendor.invoice.ocr</field>
        <field name="arch" type="xml">
            <search string="Search Vendor Invoices">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="invoice_number"/>
                <field name="email_from"/>
                <separator/>
                <filter string="Pending Review" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Processed" name="processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vendor Invoice OCR Action -->
    <record id="action_vendor_invoice_ocr" model="ir.actions.act_window">
        <field name="name">Vendor Invoice OCR</field>
        <field name="res_model">vendor.invoice.ocr</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No vendor invoices to process
            </p>
            <p>
                Vendor invoices received via email will appear here for OCR processing.
            </p>
        </field>
    </record>

</odoo>
