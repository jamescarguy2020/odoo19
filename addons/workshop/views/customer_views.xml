<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Tree View -->
    <record id="view_workshop_customer_tree" model="ir.ui.view">
        <field name="name">workshop.customer.tree</field>
        <field name="model">workshop.customer</field>
        <field name="arch" type="xml">
            <tree string="Customers">
                <field name="customer_id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="city"/>
                <field name="vehicle_count"/>
                <field name="job_count"/>
            </tree>
        </field>
    </record>

    <!-- Customer Form View -->
    <record id="view_workshop_customer_form" model="ir.ui.view">
        <field name="name">workshop.customer.form</field>
        <field name="model">workshop.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <header>
                    <button name="action_view_vehicles" type="object" string="View Vehicles" class="oe_highlight" invisible="vehicle_count == 0"/>
                    <button name="action_view_jobs" type="object" string="View Jobs" class="oe_highlight" invisible="job_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vehicles" type="object" class="oe_stat_button" icon="fa-car">
                            <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                        </button>
                        <button name="action_view_jobs" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="job_count" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vehicles" name="vehicles">
                            <field name="vehicle_ids">
                                <tree>
                                    <field name="registration_number"/>
                                    <field name="brand_id"/>
                                    <field name="model"/>
                                    <field name="year"/>
                                    <field name="job_count"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Customer notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Customer Search View -->
    <record id="view_workshop_customer_search" model="ir.ui.view">
        <field name="name">workshop.customer.search</field>
        <field name="model">workshop.customer</field>
        <field name="arch" type="xml">
            <search string="Search Customers">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="city"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Customer Action -->
    <record id="action_workshop_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">workshop.customer</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer
            </p>
            <p>
                Manage your workshop customers and their contact information.
            </p>
        </field>
    </record>

</odoo>
