<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="group_workshop_user" model="res.groups">
        <field name="name">Workshop User</field>
        <field name="category_id" ref="base.module_category_services_workshop"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Workshop Manager</field>
        <field name="category_id" ref="base.module_category_services_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_workshop_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="workshop_customer_rule" model="ir.rule">
        <field name="name">Workshop Customer: Multi-Company</field>
        <field name="model_id" ref="model_workshop_customer"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="workshop_vehicle_rule" model="ir.rule">
        <field name="name">Workshop Vehicle: Multi-Company</field>
        <field name="model_id" ref="model_workshop_vehicle"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="workshop_job_rule" model="ir.rule">
        <field name="name">Workshop Job: Multi-Company</field>
        <field name="model_id" ref="model_workshop_workshop_job"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
